{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "in-process",
  "hooks": {
    "TeammateIdle": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/teammate-idle-guard.sh"
          }
        ]
      }
    ]
  },
  "worktree": {
    "bgIsolation": "none"
  },
  "permissions": {
    "allow": [
      "Bash(python3 scripts/lint_wiki.py*)",
      "Bash(python3 scripts/verify_site.py*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(cd site && npx quartz build*)",
      "Bash(npx quartz build*)",
      "Bash(python3 -m youtube_transcript_api*)"
    ]
  }
}
